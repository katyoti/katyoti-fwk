{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@display/*":                     ["../../ktw-display/src/*"],
      "@ktw/display-lib":                ["../../ktw-display-lib/src/index.ts"],
      "@ktw/display-lib/schema":         ["../../ktw-display-lib/src/schema/index.ts"],
      "@ktw/display-lib/types":          ["../../ktw-display-lib/src/types/index.ts"],
      "@ktw/display-lib/registry-wire":  ["../../ktw-display-lib/src/registry-wire.ts"],
      "@ktw/display-lib/ui-core/*":      ["../../ktw-display-lib/src/ui-core/*"],
      "@ktw/display-lib/ui-builders/*":  ["../../ktw-display-lib/src/ui-builders/*"],
      "@ktw/display-lib/utils/*":        ["../../ktw-display-lib/src/utils/*"]
    }
  },
  "include": [
    "src",
    "../../ktw-display/src/postmessage.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
