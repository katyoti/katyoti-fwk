            <mxCell style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;strokeWidth=1;strokeColor=#828282;dashed=1;" edge="1" parent="1">
              <mxGeometry relative="1" as="geometry">
