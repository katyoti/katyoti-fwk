          <UserObject label="&lt;b&gt;%name%&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;%typeLine%&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;%description%&lt;/span&gt;" placeholders="1" name="Container" ktw-template="Container" id="tpl-Container">
            <mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;fontSize=12;" vertex="1" parent="1">
              <mxGeometry x="40" y="280" width="240" height="120" as="geometry"/>
            </mxCell>
