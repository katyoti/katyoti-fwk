            <mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0D5091;fontSize=12;" vertex="1" parent="1">
              <mxGeometry x="600" y="40" width="240" height="120" as="geometry"/>
