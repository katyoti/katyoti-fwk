                <mxPoint x="560" y="800" as="sourcePoint"/>
                <mxPoint x="760" y="800" as="targetPoint"/>
              </mxGeometry>
            </mxCell>
          </UserObject>
          <UserObject label="%name%" placeholders="1" name="Pool" ktw-template="zone" id="tpl-zone">
            <mxCell style="swimlane;html=1;startSize=30;horizontal=0;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=12;" vertex="1" parent="1">
              <mxGeometry x="40" y="900" width="600" height="200" as="geometry"/>
            </mxCell>
          </UserObject>
          <UserObject label="%name%" placeholders="1" name="Lane" ktw-template="zone:nested" id="tpl-zone-nested">
            <mxCell style="swimlane;html=1;startSize=30;horizontal=0;container=1;collapsible=0;fillColor=none;strokeColor=#333333;fontStyle=0;fontSize=11;" vertex="1" parent="1">
              <mxGeometry x="700" y="900" width="600" height="120" as="geometry"/>
            </mxCell>
          </UserObject>
          <UserObject label="&lt;b&gt;%name%&lt;/b&gt;" placeholders="1" name="Unknown kind" ktw-template="*" id="tpl-default">
            <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1">
