              <mxGeometry x="760" y="600" width="60" height="60" as="geometry"/>
            </mxCell>
          </UserObject>
          <UserObject label="%name%" placeholders="1" name="" ktw-template="edge:sequenceFlow" id="tpl-edge-sequenceFlow">
            <mxCell style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=blockThin;endFill=1;strokeColor=#333333;" edge="1" parent="1">
              <mxGeometry relative="1" as="geometry">
                <mxPoint x="40" y="800" as="sourcePoint"/>
                <mxPoint x="240" y="800" as="targetPoint"/>
              </mxGeometry>
            </mxCell>
          </UserObject>
          <UserObject label="%name%" placeholders="1" name="" ktw-template="edge:messageFlow" id="tpl-edge-messageFlow">
            <mxCell style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=8 4;endArrow=blockThin;endFill=0;startArrow=oval;startFill=0;strokeColor=#333333;" edge="1" parent="1">
