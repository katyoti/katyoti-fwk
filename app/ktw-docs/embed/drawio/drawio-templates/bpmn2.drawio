              <mxGeometry x="400" y="600" width="50" height="50" as="geometry"/>
            </mxCell>
          </UserObject>
          <UserObject label="%name%" placeholders="1" name="Data Object" ktw-template="DataObject" id="tpl-DataObject">
            <mxCell style="shape=mxgraph.bpmn.data2;html=1;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;size=15;fontSize=10;" vertex="1" parent="1">
              <mxGeometry x="580" y="600" width="40" height="60" as="geometry"/>
            </mxCell>
          </UserObject>
          <UserObject label="%name%" placeholders="1" name="Data Store" ktw-template="DataStore" id="tpl-DataStore">
