<mxfile host="ktw-docs">
    <diagram name="templates">
      <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1300">
        <root>
          <mxCell id="0"/>
          <mxCell id="1" parent="0"/>
          <UserObject label="%name%" placeholders="1" name="Task" ktw-template="Task" id="tpl-Task">
            <mxCell style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;taskMarker=abstract;" vertex="1" parent="1">
              <mxGeometry x="40" y="40" width="120" height="80" as="geometry"/>
            </mxCell>
          </UserObject>
